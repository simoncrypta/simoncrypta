{
  "name": "simoncrypta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "preview:worker": "astro build && node scripts/worker-preview.ts",
    "check": "astro sync && vp check",
    "fix": "astro sync && vp check --fix",
    "build:worker": "astro build && cf-wrangler build",
    "deploy:check": "pnpm build:worker && cf deploy --prebuilt --dry-run",
    "deploy": "pnpm build:worker && cf deploy --prebuilt",
    "preview:upload": "pnpm build:worker && cf previews deploy --prebuilt"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@cloudflare/config": "0.24.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "cf": "1.0.0-beta.14",
    "dialkit": "2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.2",
    "vite-plus": "1.1.0",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.11.2"
}
