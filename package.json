{
  "name": "simoncrypta",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.tsx",
    "dev": "bun --watch build.tsx & bun serve.ts",
    "serve": "bun serve.ts",
    "preview": "bun build.tsx && bun serve.ts",
    "check": "vp check",
    "fix": "vp check --fix",
    "cf:dev": "bun run build && cf dev",
    "deploy:check": "bun run build && cf deploy --dry-run",
    "deploy": "bun run build && cf deploy",
    "preview:upload": "bun run build && cf workers versions create"
  },
  "dependencies": {
    "@kitajs/html": "^4.2.13"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "cf": "1.0.0-beta.14",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
