{
  "name": "simoncrypta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "preview:worker": "astro build && node scripts/worker-preview.ts",
    "check": "astro sync && vp check",
    "fix": "astro sync && vp check --fix",
    "deploy:check": "bun run build && cf deploy --dry-run",
    "deploy": "bun run build && cf deploy",
    "preview:upload": "bun run build && cf workers versions create"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@cloudflare/config": "0.24.1",
    "@types/node": "^26",
    "cf": "1.0.0-beta.14",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.3"
}
