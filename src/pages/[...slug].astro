---
import PagePhoto from "../components/PagePhoto.astro";
import Portrait from "../components/Portrait.astro";
import Layout from "../layouts/Layout.astro";
import { markdownPath } from "../lib/feeds";
import { type ContentPage, getContentPages } from "../lib/pages";
import { pageSegments } from "../lib/page-photos";

export async function getStaticPaths() {
  const pages = await getContentPages();
  return pages.map((page) => ({ params: { slug: page.slug }, props: page }));
}

const page = Astro.props as ContentPage;
// Rendered Markdown, split where photos go (see src/lib/page-photos.ts).
const segments = pageSegments(page.slug, page.entry.rendered?.html ?? "");
---

<Layout
  title={page.title}
  currentPath={page.path}
  isArticle={page.slug !== undefined}
  markdownPath={markdownPath(page.path)}
>
  <content data-page={page.slug ?? "home"}>
    {page.slug === undefined && <Portrait />}
    {
      segments.map(({ html, photos }) => (
        <>
          <Fragment set:html={html} />
          {photos.map((photo) => (
            <PagePhoto {...photo} />
          ))}
        </>
      ))
    }
  </content>
</Layout>
