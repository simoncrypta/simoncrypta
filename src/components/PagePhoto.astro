---
import { Picture } from "astro:assets";
import type { PagePhoto } from "../lib/page-photos";

type Props = PagePhoto;

const { src, alt } = Astro.props;
---

<figure
  data-tilt-photo
  class="float-right m-0 mb-4 ml-8 w-60 [&~h2]:clear-both [&~hr]:clear-both mobile:float-none mobile:mx-0 mobile:mb-6"
>
  <div class="tilt relative overflow-hidden rounded-2xl">
    <Picture
      src={src}
      alt={alt}
      formats={["avif", "webp"]}
      widths={[240, 480, 720]}
      sizes="240px"
      loading="lazy"
      decoding="async"
      class="block aspect-square h-auto w-full object-cover"
    />
    <div aria-hidden="true" class="sheen pointer-events-none absolute inset-0"></div>
  </div>
</figure>

<style>
  /* Pointer tilt and holographic sheen; tilt-photo.ts sets the variables. */
  [data-tilt-photo] {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 50%;
  }

  .tilt {
    transform: perspective(700px) rotateX(var(--rx)) rotateY(var(--ry));
    box-shadow: 0 1px 3px -1px rgb(0 0 0 / 0.2);
    transition:
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-tilt="active"] .tilt {
    box-shadow: 0 14px 28px -14px rgb(0 0 0 / 0.5);
    transition-duration: 150ms, 300ms;
  }

  .sheen {
    background:
      radial-gradient(circle at var(--mx) var(--my), rgb(255 255 255 / 0.4), transparent 55%),
      linear-gradient(
        115deg,
        transparent 20%,
        rgb(255 70 170 / 0.55) 34%,
        rgb(255 215 70 / 0.55) 44%,
        rgb(70 255 190 / 0.55) 54%,
        rgb(80 150 255 / 0.55) 64%,
        rgb(190 100 255 / 0.55) 72%,
        transparent 86%
      );
    background-size:
      100% 100%,
      300% 300%;
    background-position:
      0 0,
      var(--mx) var(--my);
    mix-blend-mode: overlay;
    opacity: 0;
    transition: opacity 600ms ease-out;
  }
  [data-tilt="active"] .sheen {
    opacity: 1;
    transition-duration: 200ms;
  }

  /* Reduced motion: no tilt, just a still sheen on hover. */
  @media (prefers-reduced-motion: reduce) and (hover: hover) and (pointer: fine) {
    [data-tilt-photo]:hover .sheen {
      opacity: 0.7;
      transition: none;
    }
  }
</style>

<script>
  import { mountTiltPhoto } from "../lib/tilt-photo";

  // Same lifecycle as Portrait.astro: ClientRouter keeps this module alive.
  const mounted = new Map<HTMLElement, () => void>();

  function mountAll() {
    for (const card of document.querySelectorAll<HTMLElement>("[data-tilt-photo]")) {
      if (!mounted.has(card)) mounted.set(card, mountTiltPhoto(card));
    }
  }

  function unmountAll() {
    for (const dispose of mounted.values()) dispose();
    mounted.clear();
  }

  mountAll();
  document.addEventListener("astro:page-load", mountAll);
  document.addEventListener("astro:before-swap", unmountAll);
</script>
