---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const links = [
  { href: "/", label: "About" },
  { href: "/now/", label: "Now" },
  { href: "/uses/", label: "Uses" },
];
---

<header
  class="mb-12 flex items-center justify-between gap-4 mobile:mb-8 mobile:flex-col mobile:items-start mobile:gap-3"
>
  <a
    href="/"
    class="inline-flex min-h-11 items-center font-display text-4xl leading-none font-normal text-fg no-underline hover:text-accent mobile:text-[2rem]"
  >
    Simon's Crypta
  </a>
  <nav aria-label="Primary" class="flex gap-6 text-lg mobile:gap-5">
    {
      links.map(({ href, label }) => (
        <a
          href={href}
          aria-current={currentPath === href ? "page" : undefined}
          class:list={[
            "inline-flex min-h-11 items-center hover:text-link hover:underline",
            currentPath === href
              ? "font-semibold text-fg decoration-accent decoration-2 underline-offset-8"
              : "text-muted no-underline",
          ]}
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>
