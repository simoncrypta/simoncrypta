{
  "rules": [
    {
      "description": "Redirect www.simoncrypta.dev to simoncrypta.dev",
      "expression": "(http.host eq \"www.simoncrypta.dev\")",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "expression": "concat(\"https://simoncrypta.dev\", http.request.uri.path)"
          },
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
